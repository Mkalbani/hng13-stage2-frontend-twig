{% extends "layouts/base.html.twig" %}

{% block title %}Dashboard - TicketFlow{% endblock %}

{% block content %}
<div class="min-h-screen flex flex-col bg-gray-50">
    <div class="flex-1 py-12">
        <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8">
            <div class="mb-8">
                <h1 class="text-4xl font-bold text-gray-900 mb-2">Welcome back, {{ user.name }}!</h1>
                <p class="text-gray-600">Here's an overview of your ticket management system</p>
            </div>

            {# Stats Grid #}
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
                <div class="bg-white p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow">
                    <div class="flex items-center justify-between mb-4">
                        <div class="p-3 bg-blue-100 rounded-lg">
                            <i data-lucide="ticket" class="text-blue-600 w-6 h-6"></i>
                        </div>
                        <span class="text-3xl font-bold text-gray-900" id="total-tickets">0</span>
                    </div>
                    <h3 class="text-gray-600 font-medium">Total Tickets</h3>
                </div>

                <div class="bg-white p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow">
                    <div class="flex items-center justify-between mb-4">
                        <div class="p-3 bg-green-100 rounded-lg">
                            <i data-lucide="check-circle" class="text-green-600 w-6 h-6"></i>
                        </div>
                        <span class="text-3xl font-bold text-gray-900" id="open-tickets">0</span>
                    </div>
                    <h3 class="text-gray-600 font-medium">Open Tickets</h3>
                </div>

                <div class="bg-white p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow">
                    <div class="flex items-center justify-between mb-4">
                        <div class="p-3 bg-amber-100 rounded-lg">
                            <i data-lucide="clock" class="text-amber-600 w-6 h-6"></i>
                        </div>
                        <span class="text-3xl font-bold text-gray-900" id="in-progress-tickets">0</span>
                    </div>
                    <h3 class="text-gray-600 font-medium">In Progress</h3>
                </div>

                <div class="bg-white p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow">
                    <div class="flex items-center justify-between mb-4">
                        <div class="p-3 bg-gray-100 rounded-lg">
                            <i data-lucide="x-circle" class="text-gray-600 w-6 h-6"></i>
                        </div>
                        <span class="text-3xl font-bold text-gray-900" id="closed-tickets">0</span>
                    </div>
                    <h3 class="text-gray-600 font-medium">Closed Tickets</h3>
                </div>
            </div>

            {# Quick Actions #}
            <div class="bg-white rounded-xl shadow-lg p-8">
                <h2 class="text-2xl font-bold mb-6">Quick Actions</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <a href="/tickets"
                       class="p-6 border-2 border-blue-200 rounded-lg hover:border-blue-400 hover:bg-blue-50 transition-all text-left">
                        <i data-lucide="ticket" class="text-blue-600 mb-3 w-8 h-8"></i>
                        <h3 class="text-lg font-semibold mb-2">Manage Tickets</h3>
                        <p class="text-gray-600 text-sm">View, create, edit, and delete tickets</p>
                    </a>
                    
                    <a href="/tickets"
                       class="p-6 border-2 border-green-200 rounded-lg hover:border-green-400 hover:bg-green-50 transition-all text-left">
                        <i data-lucide="plus" class="text-green-600 mb-3 w-8 h-8"></i>
                        <h3 class="text-lg font-semibold mb-2">Create New Ticket</h3>
                        <p class="text-gray-600 text-sm">Add a new ticket to the system</p>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascript %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Get tickets from localStorage
    const storedTickets = localStorage.getItem('ticketapp_tickets');
    const tickets = storedTickets ? JSON.parse(storedTickets) : [];
    
    // Update stats
    document.getElementById('total-tickets').textContent = tickets.length;
    document.getElementById('open-tickets').textContent = tickets.filter(t => t.status === 'open').length;
    document.getElementById('in-progress-tickets').textContent = tickets.filter(t => t.status === 'in_progress').length;
    document.getElementById('closed-tickets').textContent = tickets.filter(t => t.status === 'closed').length;
});
</script>
{% endblock %}