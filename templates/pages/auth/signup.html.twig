{% set base = base_path|default('') %}
{% extends "layouts/base.html.twig" %}

{% block title %}Create Account - TicketFlow{% endblock %}

{% block content %}
<div class="min-h-screen flex flex-col bg-gray-50">
    <div class="flex-1 flex items-center justify-center py-12">
        <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8">
            <div class="max-w-md mx-auto bg-white rounded-xl shadow-lg p-8">
                <h2 class="text-3xl font-bold text-center mb-2">Create Account</h2>
                <p class="text-gray-600 text-center mb-8">Join TicketFlow today</p>
                
                <form onsubmit="event.preventDefault(); handleSignup();" class="space-y-6">
                    <div>
                        <label for="signup-name" class="block text-sm font-medium text-gray-700 mb-2">
                            Full Name
                        </label>
                        <input
                            id="signup-name"
                            type="text"
                            required
                            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none"
                            placeholder="John Doe"
                        />
                        <p id="signup-name-error" class="text-red-500 text-sm mt-1 hidden" role="alert"></p>
                    </div>

                    <div>
                        <label for="signup-email" class="block text-sm font-medium text-gray-700 mb-2">
                            Email Address
                        </label>
                        <input
                            id="signup-email"
                            type="email"
                            required
                            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none"
                            placeholder="john@example.com"
                        />
                        <p id="signup-email-error" class="text-red-500 text-sm mt-1 hidden" role="alert"></p>
                    </div>

                    <div>
                        <label for="signup-password" class="block text-sm font-medium text-gray-700 mb-2">
                            Password
                        </label>
                        <input
                            id="signup-password"
                            type="password"
                            required
                            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none"
                            placeholder="••••••••"
                        />
                        <p id="signup-password-error" class="text-red-500 text-sm mt-1 hidden" role="alert"></p>
                    </div>

                    <div>
                        <label for="signup-confirm-password" class="block text-sm font-medium text-gray-700 mb-2">
                            Confirm Password
                        </label>
                        <input
                            id="signup-confirm-password"
                            type="password"
                            required
                            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none"
                            placeholder="••••••••"
                        />
                        <p id="signup-confirm-password-error" class="text-red-500 text-sm mt-1 hidden" role="alert"></p>
                    </div>

                    <button
                        type="submit"
                        class="w-full py-3 bg-blue-600 text-white rounded-lg font-semibold hover:bg-blue-700 transition-colors"
                    >
                        Create Account
                    </button>
                </form>
                
                <p class="text-center mt-6 text-gray-600">
                    Already have an account?{' '}
                    <a href="{{ base }}/auth/login" class="text-blue-600 font-semibold hover:underline">
                        Login
                    </a>
                </p>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascript %}
{{ parent() }}
<script>
function handleSignup() {
    const name = document.getElementById('signup-name').value;
    const email = document.getElementById('signup-email').value;
    const password = document.getElementById('signup-password').value;
    const confirmPassword = document.getElementById('signup-confirm-password').value;
    
    // Clear previous errors
    document.getElementById('signup-name-error').classList.add('hidden');
    document.getElementById('signup-email-error').classList.add('hidden');
    document.getElementById('signup-password-error').classList.add('hidden');
    document.getElementById('signup-confirm-password-error').classList.add('hidden');
    
    // Validate
    let hasError = false;
    
    if (!name) {
        document.getElementById('signup-name-error').textContent = 'Name is required';
        document.getElementById('signup-name-error').classList.remove('hidden');
        hasError = true;
    } else if (name.length < 2) {
        document.getElementById('signup-name-error').textContent = 'Name must be at least 2 characters';
        document.getElementById('signup-name-error').classList.remove('hidden');
        hasError = true;
    }
    
    if (!email) {
        document.getElementById('signup-email-error').textContent = 'Email is required';
        document.getElementById('signup-email-error').classList.remove('hidden');
        hasError = true;
    } else if (!/\S+@\S+\.\S+/.test(email)) {
        document.getElementById('signup-email-error').textContent = 'Invalid email format';
        document.getElementById('signup-email-error').classList.remove('hidden');
        hasError = true;
    }
    
    if (!password) {
        document.getElementById('signup-password-error').textContent = 'Password is required';
        document.getElementById('signup-password-error').classList.remove('hidden');
        hasError = true;
    } else if (password.length < 6) {
        document.getElementById('signup-password-error').textContent = 'Password must be at least 6 characters';
        document.getElementById('signup-password-error').classList.remove('hidden');
        hasError = true;
    }
    
    if (password !== confirmPassword) {
        document.getElementById('signup-confirm-password-error').textContent = 'Passwords do not match';
        document.getElementById('signup-confirm-password-error').classList.remove('hidden');
        hasError = true;
    }
    
    if (!hasError) {
        const result = signup(name, email, password);
        if (!result.success) {
            document.getElementById('signup-email-error').textContent = result.error;
            document.getElementById('signup-email-error').classList.remove('hidden');
        }
    }
}
</script>
{% endblock %}