{
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "yum install -y php && curl -sS https://getcomposer.org/installer | php && php composer.phar install && php scripts/build.php",
  "routes": [
    { "src": "/css/(.*)", "dest": "/css/$1" },
    { "src": "/js/(.*)", "dest": "/js/$1" },
    { "src": "/auth/login", "dest": "/auth/login/index.html" },
    { "src": "/auth/signup", "dest": "/auth/signup/index.html" },
    { "src": "/dashboard", "dest": "/dashboard/index.html" },
    { "src": "/tickets", "dest": "/tickets/index.html" },
    { "src": "/", "dest": "/index.html" }
  ]
}